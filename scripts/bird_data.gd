static func ids() -> Array:
	var list: Array = SPECIES.keys()
	list.sort_custom(func(a: String, b: String) -> bool:
		var rank_a := STATUS_ORDER.find(str(SPECIES[a]["status"]))
		var rank_b := STATUS_ORDER.find(str(SPECIES[b]["status"]))
		return rank_a < rank_b if rank_a != rank_b else str(SPECIES[a]["name"]) < str(SPECIES[b]["name"]))
	return list


static func info(species: String) -> Dictionary:
	return SPECIES.get(species, {})
